---
const today = new Date();
import Chatbot from './Chatbot.tsx';
---


<footer class="bg-gray-50 border-t border-gray-200 mt-20">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
			<div class="col-span-1 md:col-span-2">
				<a href="/" class="flex items-center gap-2 mb-4">
					<img src="/mhu-logo.png" alt="MHU Travel Logo" class="h-10 w-auto" onerror="this.onerror=null; this.src='https://via.placeholder.com/150x50?text=MHU+Travel';">
				</a>
				<p class="text-gray-600 text-sm leading-relaxed max-w-sm">
					MHU Travel (Manasik Haji Umrah) adalah biro perjalanan umroh dan haji terpercaya yang siap membantu mewujudkan niat suci Anda ke Baitullah dengan layanan terbaik dan harga terjangkau.
				</p>
			</div>
			
			<div>
				<h3 class="text-[#c15b74] font-semibold mb-4">Tautan</h3>
				<ul class="space-y-3">
					<li><a href="/" class="text-gray-600 hover:text-[#c15b74] transition-colors text-sm">Beranda</a></li>
					<li><a href="/#paket" class="text-gray-600 hover:text-[#c15b74] transition-colors text-sm">Paket Umroh</a></li>
					<li><a href="/jadwal" class="text-gray-600 hover:text-[#c15b74] transition-colors text-sm">Update Seat</a></li>
					<li><a href="/blog" class="text-gray-600 hover:text-[#c15b74] transition-colors text-sm">Blog</a></li>
				</ul>
			</div>

			<div>
				<h3 class="text-[#c15b74] font-semibold mb-4">Hubungi Kami</h3>
				<ul class="space-y-3">
					<li>
						<a href="https://wa.me/6285956129389?text=halo%20admin%2C%20saya%20tertarik%20dengan%20Paket%20umroh%20MHU.%20Mohon%20Info%20selanjutnya" class="text-gray-600 hover:text-[#c15b74] transition-colors text-sm flex items-center gap-2">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
							0859-5612-9389
						</a>
					</li>
					<li class="flex items-start gap-2 text-gray-600 text-sm">
						<svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
						<span>Alamat Kantor MHU Travel<br/>Indonesia</span>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 pt-8 border-t border-gray-200 text-center text-gray-500 text-sm">
			&copy; {today.getFullYear()} MHU Travel. All rights reserved.
		</div>
	</div>
</footer>
<Chatbot client:load />
