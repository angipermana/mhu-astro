---
import HeaderLink from './HeaderLink.astro';

const months = [
  'juli', 'agustus', 'september', 'oktober', 'november', 'desember'
];

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<header class="w-full bg-white shadow-sm z-50 sticky top-0">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-24">
			<div class="flex items-center">
				<a href="/" class="flex-shrink-0 flex items-center gap-2">
					<img src="https://manasikhajiumrah.net/wp-content/uploads/2025/08/cropped-logo-1-300x86-1-1.png" alt="MHU Travel Logo" class="h-12 w-auto" onerror="this.onerror=null; this.src='https://via.placeholder.com/150x50?text=MHU+Travel';">
				</a>
			</div>
			
			<!-- Desktop Menu -->
			<nav class="hidden md:flex space-x-8 items-center">
				<a href="/" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors">Beranda</a>
				<div class="relative group py-2">
					<a href="/#paket" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors flex items-center">Paket Umroh <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></a>
					
					<!-- Dropdown Menu -->
					<div class="absolute left-0 top-full mt-0 w-64 bg-white border border-gray-100 shadow-lg rounded-md opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
						<div class="py-2">
							<a href="/#paket" class="block px-4 py-2 text-sm text-[#c15b74] hover:bg-pink-50 font-medium border-b border-gray-50 mb-1">
								Lihat Semua Paket
							</a>
							{months.map((month) => (
								<a href={`/umroh-${month}-mhu-travel`} class="block px-4 py-2 text-sm text-gray-600 hover:bg-pink-50 hover:text-[#c15b74]">
									Umroh {capitalize(month)} 2026
								</a>
							))}
						</div>
					</div>
				</div>
				<a href="/jadwal" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors">Update Seat</a>
				<a href="/blog" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors">Blog</a>
				
				<a href="https://wa.me/6285956129389?text=halo%20admin%2C%20saya%20tertarik%20dengan%20Paket%20umroh%20MHU.%20Mohon%20Info%20selanjutnya" class="text-[#c15b74] font-medium flex items-center gap-2 hover:text-[#a0455d] transition-colors">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
					0859-5612-9389
				</a>
			</nav>

			<!-- Mobile Menu Button (Hamburger) -->
			<div class="md:hidden flex items-center ml-auto">
				<button id="mobile-menu-button" class="text-[#c15b74] hover:text-[#a0455d] focus:outline-none p-2 border border-[#c15b74] rounded-md flex items-center justify-center">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
				</button>
			</div>
		</div>
	</div>

	{/* Mobile Menu Panel */}
	<div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg absolute w-full left-0">
		<div class="px-4 pt-2 pb-6 space-y-1">
			<a href="/" class="block px-3 py-3 text-[#c15b74] font-medium hover:bg-pink-50 rounded-md">Beranda</a>
			<details class="group [&_summary::-webkit-details-marker]:hidden">
				<summary class="flex justify-between items-center px-3 py-3 text-[#c15b74] font-medium hover:bg-pink-50 rounded-md cursor-pointer list-none">
					<span>Paket Umroh</span>
					<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
				</summary>
				<div class="pl-4 pr-2 pb-2 space-y-1">
					<a href="/#paket" class="block px-3 py-2 text-sm text-[#c15b74] font-medium hover:bg-pink-50 rounded-md mb-1">Lihat Semua Paket</a>
					{months.map((month) => (
						<a href={`/umroh-${month}-mhu-travel`} class="block px-3 py-2 text-sm text-gray-600 hover:bg-pink-50 hover:text-[#c15b74] rounded-md">
							Umroh {capitalize(month)} 2026
						</a>
					))}
				</div>
			</details>
			<a href="/jadwal" class="block px-3 py-3 text-[#c15b74] font-medium hover:bg-pink-50 rounded-md">Update Seat</a>
			<a href="/blog" class="block px-3 py-3 text-[#c15b74] font-medium hover:bg-pink-50 rounded-md">Blog</a>
			<a href="https://wa.me/6285956129389?text=halo%20admin%2C%20saya%20tertarik%20dengan%20Paket%20umroh%20MHU.%20Mohon%20Info%20selanjutnya" class="block px-3 py-3 text-[#c15b74] font-medium hover:bg-pink-50 rounded-md flex items-center gap-2">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
				0859-5612-9389
			</a>
		</div>
	</div>
</header>

<script>
	function setupMobileMenu() {
		const mobileMenuButton = document.getElementById('mobile-menu-button');
		const mobileMenu = document.getElementById('mobile-menu');

		if (mobileMenuButton && mobileMenu) {
			// Remove existing listeners by cloning (simple way to ensure no duplicates)
			const newButton = mobileMenuButton.cloneNode(true);
			mobileMenuButton.parentNode.replaceChild(newButton, mobileMenuButton);
			
			newButton.addEventListener('click', () => {
				mobileMenu.classList.toggle('hidden');
			});
		}
	}

	// Gunakan event DOMContentLoaded jika Astro View Transitions tidak diaktifkan
	document.addEventListener('DOMContentLoaded', setupMobileMenu);
	// Atau panggil langsung karena script ini berada di bagian akhir
	setupMobileMenu();
</script>
