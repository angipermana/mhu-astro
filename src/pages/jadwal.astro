---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import schedulesData from '../data/schedules.json';

const schedules = schedulesData.items || [];
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title="Update Seat & Jadwal Umroh 2026 | MHU Travel" description="Cek jadwal keberangkatan umroh terbaru dan update sisa seat dari MHU Travel." />
	</head>
	<body class="font-sans text-gray-800 antialiased bg-white flex flex-col min-h-screen">
		<!-- Header / Navbar -->
		<header class="w-full bg-white shadow-sm z-50 sticky top-0">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-24">
					<div class="flex items-center">
						<a href="/" class="flex-shrink-0 flex items-center gap-2">
							<img src="https://manasikhajiumrah.net/wp-content/uploads/2025/08/cropped-logo-1-300x86-1-1.png" alt="MHU Travel Logo" class="h-12 w-auto" onerror="this.onerror=null; this.src='https://via.placeholder.com/150x50?text=MHU+Travel';">
						</a>
					</div>
					<nav class="hidden md:flex space-x-8 items-center">
						<a href="/" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors">Beranda</a>
						<div class="relative group">
							<a href="/#paket" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors flex items-center">Paket Umroh</a>
						</div>
						<a href="/jadwal" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors">Update Seat</a>
						<a href="/blog" class="text-[#c15b74] font-medium hover:text-[#a0455d] transition-colors">Blog</a>
						
						<a href="https://wa.me/6285956129389" class="text-[#c15b74] font-medium flex items-center gap-2 hover:text-[#a0455d] transition-colors">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
							0859-5612-9389
						</a>
					</nav>
				</div>
			</div>
		</header>

		<main class="flex-grow py-16 px-4 bg-[#f7f9fb]">
			<div class="max-w-6xl mx-auto">
				<h1 class="text-3xl md:text-4xl font-normal text-[#c15b74] mb-4 text-center">Update Seat & Jadwal Keberangkatan</h1>
				<p class="text-center text-gray-700 mb-12 max-w-2xl mx-auto leading-relaxed">Berikut adalah informasi terbaru mengenai jadwal keberangkatan umroh beserta sisa seat yang tersedia. Segera amankan kursi Anda sebelum kehabisan!</p>

				<!-- Tabel Keberangkatan -->
				<div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100">
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse min-w-[800px]">
							<thead>
								<tr class="bg-[#c15b74] text-white">
									<th class="py-4 px-6 font-semibold border-b border-[#a0455d]">Tanggal Keberangkatan</th>
									<th class="py-4 px-6 font-semibold border-b border-[#a0455d]">Program / Paket</th>
									<th class="py-4 px-6 font-semibold border-b border-[#a0455d]">Pesawat</th>
									<th class="py-4 px-6 font-semibold border-b border-[#a0455d]">Durasi</th>
									<th class="py-4 px-6 font-semibold border-b border-[#a0455d]">Sisa Seat</th>
									<th class="py-4 px-6 font-semibold border-b border-[#a0455d] text-center">Aksi</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								{schedules.map((schedule, index) => {
									let badgeClass = "bg-green-100 text-green-800";
									if (schedule.statusColor === 'yellow') {
										badgeClass = "bg-yellow-100 text-yellow-800";
									} else if (schedule.statusColor === 'red') {
										badgeClass = "bg-red-100 text-red-800";
									}

									return (
										<tr class={`${index % 2 !== 0 ? 'bg-gray-50 ' : ''}hover:bg-pink-50 transition-colors`}>
											<td class="py-4 px-6 text-gray-800">{schedule.tanggal}</td>
											<td class="py-4 px-6 font-medium text-[#3569b4]">{schedule.paket}</td>
											<td class="py-4 px-6 text-gray-600">{schedule.pesawat}</td>
											<td class="py-4 px-6 text-gray-600">{schedule.durasi}</td>
											<td class="py-4 px-6">
												<span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${badgeClass}`}>
													{schedule.sisaSeat}
												</span>
											</td>
											<td class="py-4 px-6 text-center">
												<a href={schedule.linkBooking} class="text-sm font-bold text-white bg-[#c15b74] hover:bg-[#a0455d] px-4 py-2 rounded transition-colors inline-block">
													Booking
												</a>
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				</div>

				<div class="mt-8 text-center text-sm text-gray-500">
					* Jadwal dan ketersediaan seat dapat berubah sewaktu-waktu. Hubungi admin untuk memastikan ketersediaan secara real-time.
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="bg-[#c15b74] text-white pt-16 pb-8 mt-auto">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
					<!-- Company Info -->
					<div class="col-span-1 md:col-span-2">
						<div class="bg-white inline-block p-3 rounded-lg mb-6">
							<img src="https://manasikhajiumrah.net/wp-content/uploads/2025/08/cropped-logo-1-300x86-1-1.png" alt="MHU Travel Logo" class="h-10 md:h-12 w-auto" onerror="this.onerror=null; this.src='https://via.placeholder.com/150x50?text=MHU+Travel';">
						</div>
						<p class="text-sm leading-relaxed mb-6 text-pink-50">
							PT Manasik Haji Umrah (MHU Travel) adalah agen travel perjalanan ibadah Umroh dan Haji khusus yang berizin resmi (PPIU), terpercaya, dan amanah. Kami berkomitmen memberikan pelayanan terbaik demi kenyamanan ibadah Anda di Tanah Suci.
						</p>
					</div>

					<!-- Quick Links -->
					<div>
						<h4 class="font-bold text-white mb-4 uppercase text-sm tracking-wider">Tautan Cepat</h4>
						<ul class="space-y-3 text-sm text-pink-100">
							<li><a href="/" class="hover:text-white transition-colors">Beranda</a></li>
							<li><a href="/#paket" class="hover:text-white transition-colors">Paket Umroh</a></li>
							<li><a href="/jadwal" class="hover:text-white transition-colors">Jadwal Keberangkatan</a></li>
							<li><a href="/blog" class="hover:text-white transition-colors">Artikel & Blog</a></li>
						</ul>
					</div>

					<!-- Contact Info -->
					<div>
						<h4 class="font-bold text-white mb-4 uppercase text-sm tracking-wider">Hubungi Kami</h4>
						<ul class="space-y-3 text-sm text-pink-100">
							<li class="flex items-start">
								<svg class="w-5 h-5 text-pink-200 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								<span>Kantor Pusat MHU Travel, Indonesia</span>
							</li>
							<li class="flex items-start">
								<svg class="w-5 h-5 text-pink-200 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
								<a href="https://wa.me/6285956129389" class="hover:text-white transition-colors">0859-5612-9389 (WhatsApp)</a>
							</li>
							<li class="flex items-start">
								<svg class="w-5 h-5 text-pink-200 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
								<span>info@manasikhajiumrah.net</span>
							</li>
						</ul>
					</div>
				</div>
				
				<div class="border-t border-pink-400/50 pt-8 text-center text-sm text-pink-100 flex flex-col md:flex-row justify-between items-center gap-4">
					<p>&copy; 2026 MHU Travel - PT Manasik Haji Umrah. Hak Cipta Dilindungi.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
